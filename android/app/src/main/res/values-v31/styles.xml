<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+: the OS draws its own SplashScreen (ignoring windowBackground)
         before the Flutter engine attaches. Matching its background/icon to
         our Dart SplashScreen's first frame makes the handoff look like one
         continuous screen instead of two different ones. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:colorBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
